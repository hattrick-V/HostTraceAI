# Build scratch: downloaded upstream archives and the staging tree.
_build/

# Upstream OpenSSH binaries are deliberately NOT version controlled.
#
# They are third-party redistributables and belong in a versioned build
# artefact rather than in git history -- committing ~28 MB of binaries would
# slow every clone down forever. Run build-kit.ps1 to materialise this folder,
# or download the ready-made kit zip from the Releases page.
bin/

# Locally built distributables (the repository root also ignores *.zip).
*.zip
